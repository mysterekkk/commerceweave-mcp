# CommerceWeave MCP — example configuration. NEVER commit a real .env.
COMMERCEWEAVE_MODE=read_only            # read_only | proposal | approval_required
COMMERCEWEAVE_LOG_LEVEL=info            # debug | info | warn | error (logs go to stderr)
COMMERCEWEAVE_DEMO=false                # true = synthetic data, no credentials needed
# COMMERCEWEAVE_HOME=                   # default: ~/.commerceweave
# COMMERCEWEAVE_TOKEN_KEY=              # optional passphrase: encrypts stored OAuth tokens
# COMMERCEWEAVE_CONFIG=                 # optional JSON file for multiple accounts

ALLEGRO_ENABLED=false
ALLEGRO_ENVIRONMENT=sandbox             # sandbox | production
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
# then run: npx commerceweave-mcp setup allegro

BASE_ENABLED=false
BASE_API_TOKEN=

WOO_ENABLED=false
WOO_STORE_URL=https://shop.example.com
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
